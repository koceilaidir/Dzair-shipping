# Copie ce fichier en `.env` et remplis les valeurs. Le .env ne va JAMAIS sur git.
PORT=3000
DATABASE_URL=postgres://postgres:TON_MOT_DE_PASSE@localhost:5432/dzair
# Génère un secret long et aléatoire (64+ caractères) — jamais le même qu'ailleurs.
JWT_SECRET=change-moi-avec-une-longue-chaine-aleatoire
# Durée de vie du token (MVP local). En production on passera sur access court + refresh.
JWT_EXPIRES=12h
# Origine autorisée pour l'app Flutter web en dev.
CORS_ORIGIN=http://localhost:5555
